# Scholarship Finder - Environment Variables Example
# 
# Note: The MVP uses Python, Streamlit, and local SQLite storage.
# No API keys, external database hosts, or third-party cloud credentials are required.

# App Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Database Path Configuration (Optional, defaults to local SQLite file)
DATABASE_URL=sqlite:///scholarships.db